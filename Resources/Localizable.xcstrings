    "Choose Never to keep previews visible. Unsaved captures, sharing progress, errors, and finished links stay available until you act on them. Changes apply immediately.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“永不”可让预览保持显示。未保存的截图、分享进度、错误和已完成的链接会一直保留，直到你处理它们。更改会立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「永不」可讓預覽保持顯示。未儲存的截圖、分享進度、錯誤和已完成的連結會一直保留，直到你處理它們。更改會立即生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「しない」を選ぶとプレビューが表示されたままになります。未保存のキャプチャ、共有の進行状況、エラー、完成したリンクは、操作するまで残ります。変更はすぐに反映されます。"
          }
        }
      }
    },
    "Choose Save or Export when you want a file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要文件时，请选择“保存”或“导出”。"

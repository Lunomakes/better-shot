    "Automatically save the capture to the export folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动将截图保存到导出文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

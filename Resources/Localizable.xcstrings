          }
        }
      }
    },
    "The sound your Mac is playing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 正在播放的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

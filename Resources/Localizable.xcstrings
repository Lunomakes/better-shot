{
  "sourceLanguage": "en",
  "strings": {
    "%@ This happens after BetterShot is rebuilt or reinstalled. Clear the old keys and paste them in again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 这通常发生在 BetterShot 重新构建或重新安装之后。请清除旧密钥，然后重新粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 這通常發生在 BetterShot 重新建置或重新安裝之後。請清除舊的金鑰，然後重新貼上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ これは BetterShot を再ビルドまたは再インストールした後に起こります。古いキーを消去してから、もう一度貼り付けてください。"
          }
        }
      }
    },
    "%@ access allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许%@访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許%@取用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@へのアクセスを許可済み"
          }
        }
      }
    },
    "%@ available in Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在设置中使用%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在設定中使用%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は設定で利用できます"
          }
        }
      }
    },
    "%@: %@ — click to change": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ — 点按以更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ — 按一下以更改"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ — クリックして変更"
          }
        }
      }
    },
    "1 second": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 秒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 秒"
          }
        }
      }
    },
    "3 seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3 秒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3 秒"
          }
        }
      }
    },
    "5 seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 秒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 秒"
          }
        }
      }
    },
    "60 fps keeps motion smoother. 30 fps renders faster.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60 fps 动作更流畅，30 fps 渲染更快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "60 fps 動作更流暢，30 fps 輸出更快。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60 fps は動きがより滑らかに、30 fps は書き出しが速くなります。"
          }
        }
      }
    },
    "A moment to open a menu or hover something before the shot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留出一点时间打开菜单或悬停在某处再截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留一點時間打開選單或停留在某處再截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影前にメニューを開いたり、ポインタを重ねたりする時間を確保します。"
          }
        }
      }
    },
    "A specific screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指定螢幕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の画面"
          }
        }
      }
    },
    "A successful test turns uploads on for you. With uploads off, everything stays on this Mac. A viewer link shows the title, a poster and a download button, and hides the filename behind a random ID; a direct link is the raw file, filename and all.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试成功后会自动为你开启上传。关闭上传时，所有内容都只保留在这台 Mac 上。查看器链接会显示标题、封面和下载按钮，并用随机 ID 隐藏文件名；直接链接则是原始文件，包含文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試成功後會自動為你開啟上傳。關閉上傳時，所有內容都只保留在這台 Mac 上。檢視器連結會顯示標題、封面和下載按鈕，並以隨機 ID 隱藏檔名；直接連結則是原始檔案，包含檔名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストに成功すると、アップロードが自動的にオンになります。アップロードがオフの場合、すべてこの Mac 上に保持されます。ビューアリンクにはタイトル、ポスター画像、ダウンロードボタンが表示され、ファイル名はランダムな ID で隠されます。ダイレクトリンクはファイル名を含む元のファイルです。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取用權限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス"
          }
        }
      }
    },
    "Access Key ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问密钥 ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存取金鑰 ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスキー ID"
          }
        }
      }
    },
    "Access is allowed, but shortcuts aren’t active. Save your work, then quit and reopen BetterShot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许访问，但快捷键尚未生效。请保存你的工作，然后退出并重新打开 BetterShot。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許取用，但快速鍵尚未生效。請儲存你的工作，然後結束並重新打開 BetterShot。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスは許可されていますが、ショートカットはまだ有効ではありません。作業を保存してから、BetterShot を終了して再度開いてください。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "Account ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户 ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號 ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント ID"
          }
        }
      }
    },
    "Actual Size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際大小"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のサイズ"
          }
        }
      }
    },
    "Add Zoom at Playhead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放头处添加缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放點加入縮放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生ヘッドにズームを追加"
          }
        }
      }
    },
    "Add a date, a random string, or a counter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加日期、随机字符串或计数器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入日期、隨機字串或計數器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付、ランダムな文字列、またはカウンタを追加"
          }
        }
      }
    },
    "Add the Public Bucket URL above first - a direct link points straight at it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在上方填写公共存储桶 URL，直接链接会直接指向它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在上方填寫公開儲存桶 URL，直接連結會直接指向它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に上の公開バケット URL を入力してください。ダイレクトリンクはそこを直接指します。"
          }
        }
      }
    },
    "Add your Cloudflare R2 details below and every share becomes a link.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方添加你的 Cloudflare R2 信息，每次分享都会生成一个链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方加入你的 Cloudflare R2 資訊，每次分享都會產生一個連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に Cloudflare R2 の情報を追加すると、共有するたびにリンクが作成されます。"
          }
        }
      }
    },
    "Add your cloud account in Settings → Sharing, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置 → 分享”中添加你的云账户，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定 → 分享」中加入你的雲端帳號，然後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定 → 共有」でクラウドアカウントを追加してから、もう一度お試しください。"
          }
        }
      }
    },
    "Add your voice to recordings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为录制添加你的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為錄製加入你的聲音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画にナレーションを追加します。"
          }
        }
      }
    },
    "After Capture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

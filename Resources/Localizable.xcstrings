    },
    "This can take a moment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能需要一点时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這可能需要一點時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し時間がかかる場合があります。"
          }
        }
      }
    },
    "This file has been moved or deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件已被移动或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案已被移動或刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは移動または削除されました。"
          }
        }
      }
    },
    "This removes custom bindings and restores the original capture and editor keys. Additional actions become unassigned.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除自定绑定并恢复原始的截图和编辑器按键。新增的操作会变为未分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除自訂指定並回復原始的擷取和編輯器按鍵。新增的動作會變為未指定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムの割り当てを削除し、キャプチャとエディタのキーを元に戻します。追加のアクションは未割り当てになります。"
          }
        }
      }
    },
    "Timer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计时器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時器"
          }
        },

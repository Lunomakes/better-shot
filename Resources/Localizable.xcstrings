    },
    "Standard keeps every action. Sharing puts cloud sharing in the center. Minimal keeps Copy, Save, and Dismiss; click the image to edit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“标准”保留所有操作。“分享”将云分享放在中间。“精简”只保留拷贝、保存和关闭；点按图片即可编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「標準」保留所有動作。「分享」將雲端分享放在中間。「精簡」只保留拷貝、儲存和關閉；按一下影像即可編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「標準」はすべてのアクションを表示します。「共有」はクラウド共有を中央に配置します。「最小」はコピー、保存、閉じるのみで、画像をクリックすると編集できます。"
          }
        }
      }
    },
    "Start with the last area selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时选中上次的区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時選取上次的區域"
          }

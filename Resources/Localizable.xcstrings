    "Available across macOS. Use Command, Control, or Option with a key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在整个 macOS 中可用。请将 Command、Control 或 Option 与一个按键组合使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

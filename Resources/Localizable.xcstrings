    "Older entries and their internal copies are removed. Saved files and recording projects stay.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较旧的记录及其内部副本会被移除。已保存的文件和录制项目会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較舊的記錄及其內部副本會被移除。已儲存的檔案和錄製專案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い項目とその内部コピーは削除されます。保存済みファイルと録画プロジェクトは残ります。"
          }
        }
      }
    },

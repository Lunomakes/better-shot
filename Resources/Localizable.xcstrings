    "Allow BetterShot in System Settings › General › Login Items & Extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 通用 › 登录项与扩展”中允许 BetterShot。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 › 一般 › 登入項目與延伸功能」中允許 BetterShot。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 › 一般 › ログイン項目と機能拡張」で BetterShot を許可してください。"
          }
        }
      }
    },

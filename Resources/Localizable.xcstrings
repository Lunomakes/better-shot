        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャを共有するには API キーを再入力する必要があります。既存のクラウド共有は引き続き利用できます。"
          }
        }
      }
    },
    "Your last area opens already selected. Press Return to capture it again, drag its handles to adjust it, or draw a new one. Space switches to window selection, and Escape cancels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次的区域会预先选中。按 Return 再次截取，拖移控制点调整，或绘制新的区域。按空格键切换到窗口选择，按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次的區域會預先選取。按 Return 再次擷取，拖移控制點調整，或繪製新的區域。按空白鍵切換到視窗選取，按 Esc 取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の範囲が選択された状態で開きます。Return で再度キャプチャ、ハンドルをドラッグして調整、または新しい範囲を描きます。スペースでウインドウ選択に切り替え、Esc でキャンセルします。"
          }
        }
      }
    },
    "Your saved keys are locked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的密钥已锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的金鑰已鎖定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したキーはロックされています"
          }
        }
      }
    },
    "Your screenshots and recordings are left alone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的截图和录制内容不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的截圖和錄製內容不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットと録画はそのまま残ります。"
          }
        }
